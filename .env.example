# Copy this file to .env and set your paths.
# ULTIMATE_MEMORY_CONFIG points to your local config file.
# Copy config/ultimate-memory.toml.example to config/ultimate-memory.toml and edit the paths there.
# Optional — if unset, defaults to <repo_root>/config/ultimate-memory.toml.
ULTIMATE_MEMORY_CONFIG=/path/to/ultimate-memory/config/ultimate-memory.toml

# Used by `docker compose --profile router up -d` to mount your Basic Memory /
# Obsidian vault into the router container. Defaults to ./vault if unset.
ULTIMATE_MEMORY_VAULT_PATH=/path/to/your/basic-memory-vault
