[paths]
repo_root = "/path/to/ultimate-memory"
basic_memory_vault = "/path/to/your/basic-memory-vault"
private_store = "/path/to/ultimate-memory/.ultimate-memory"

[retrieval]
collection_name = "ultimate_memory_chunks"
embedding_model = "BAAI/bge-small-en-v1.5"
chunk_chars = 1200
chunk_overlap = 160
default_limit = 8
bootstrap_token_budget_chars = 12000

[qdrant]
url = "http://localhost:6333"

[neo4j]
uri = "bolt://localhost:7687"
user = "neo4j"
password = "ultimate-memory-dev"

[basic_memory]
project = "main"
cli = "basic-memory"

[dashboard]
host = "127.0.0.1"
port = 8787
